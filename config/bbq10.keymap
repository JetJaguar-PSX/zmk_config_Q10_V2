#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define SYM 1
#define UPPER 2
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&out &kp>;
        };
    };

    behaviors {
        bhm: balanced_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <400>;
            bindings = <&ext_power>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&mkp RCLK  &mkp LCLK
&mkp LCLK  &mkp MCLK  &mkp LCLK  &kp LS(CAPS)  &mkp RCLK
&kp Q      &kp W      &kp E      &kp R         &kp T               &kp Y             &kp U           &kp I         &kp O      &kp P
&kp A      &kp S      &kp D      &kp F         &kp G               &kp H             &kp J           &kp K         &kp L      &kp BACKSPACE
&tog 2     &kp Z      &kp X      &kp C         &kp V               &kp B             &kp N           &kp M         &kp LCTRL  &kp ENTER
                      &kt LSHFT                &lt 1 INT_MUHENKAN  &mt LALT SPACE    &kp INT_HENKAN  &kp LEFT_GUI
            >;
        };

        Action_Layer {
            bindings = <
&kp LEFT       &kp RIGHT
&trans         &trans          &trans         &trans         &trans
&bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2   &bt BT_SEL 3   &kp JP_LPAREN    &kp JP_RPAREN      &kp HOME       &kp END     &kp LS(LT)   &kp LS(GT)
&bt BT_DISC 0  &bt BT_DISC 1   &bt BT_DISC 2  &bt BT_DISC 3  &kp JP_LBRACKET  &kp JP_RBRACKET    &kp L          &kp R       &kp TAB      &kp JP_YEN
&none          &kp KP_NUMLOCK  &bootloader    &bt BT_CLR     &kp JP_LBRACE    &kp JP_RBRACE      &kp DOWN       &kp UP      &kp LS(TAB)  &kp JP_BACKQUOTE
                               &trans                        &trans           &trans             &kp JP_HANZEN  &kp ESCAPE
            >;
        };

        KP_Layer {
            bindings = <
&trans           &trans
&trans           &trans           &trans           &trans           &trans
&kp KP_MINUS     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS      &kp JP_CARET    &kp JP_UNDERSCORE  &kp MINUS   &kp JP_DQUOTE  &kp JP_QUOTE
&kp KP_ASTERISK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SLASH     &kp JP_COLON    &kp SEMICOLON      &kp JP_AT   &kp HASH       &trans
&trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_DOT       &kp JP_TILDE    &kp COMMA          &kp PERIOD  &kp DOLLAR     &trans
                                  &kp KP_EQUAL                      &kp KP_NUMBER_0  &trans          &kp LS(LG(S))      &kp DELETE
            >;
        };
    };
};
