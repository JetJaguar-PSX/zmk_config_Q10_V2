#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define SYM 1
#define UPPER 2
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&out &kp>;
        };
    };

    behaviors {
        bhm: balanced_homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <400>;
            bindings = <&ext_power>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 2 LEFT_ARROW    &lt 3 RIGHT_ARROW
&mt LG(TAB) K_BACK  &mkp MCLK          &mkp LCLK  &kp LS(CAPS)  &mkp RCLK
&kp Q               &kp W              &kp E      &kp R         &kp T             &kp Y        &kp U           &kp I             &kp O      &kp P
&kp A               &kp S              &kp D      &kp F         &kp G             &kp H        &kp J           &kp K             &kp L      &kp BACKSPACE
&tog 1              &kp Z              &kp X      &kp C         &kp V             &kp B        &kp N           &kp M             &kt LCTRL  &kp ENTER
                                       &kt LSHFT                &kp INT_MUHENKAN  &kt SPACE    &kp INT_HENKAN  &mt LEFT_GUI TAB
            >;
        };

        KP_Layer {
            bindings = <
&trans           &trans
&trans           &trans           &trans           &trans           &trans
&kp KP_MINUS     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_PLUS      &kp JP_CARET    &kp JP_UNDERSCORE  &kp MINUS   &kp JP_DQUOTE  &kp JP_QUOTE
&kp KP_ASTERISK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SLASH     &kp JP_COLON    &kp SEMICOLON      &kp JP_AT   &kp HASH       &trans
&trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp QUESTION     &kp EXCL        &kp COMMA          &kp PERIOD  &kp DOLLAR     &trans
                                  &kp KP_EQUAL                      &kp KP_NUMBER_0  &kp KP_DOT      &kp LS(LG(S))      &kp DELETE
            >;
        };

        Sub_Layer {
            bindings = <
&trans         &trans
&trans         &trans         &trans         &trans         &trans
&bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &kp LS(BACKSLASH)    &kp HOME  &kp END  &kp LS(LT)     &kp LS(GT)
&bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &kp AMPERSAND        &kp A     &kp A    &kp BACKSLASH  &trans
&none          &none          &none          &bt BT_CLR     &bootloader    &none                &kp DOWN  &kp UP   &kp LS(TAB)    &trans
                              &trans                        &trans         &trans               &trans    &trans
            >;
        };

        Control_Layer {
            bindings = <
&trans          &trans
&trans          &trans          &trans           &trans                  &trans
&kp HOME        &kp UP_ARROW    &kp END          &kp ESCAPE              &kp LC(LS(ESC))  &trans                     &trans          &trans  &trans  &trans
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LA(LC(UP_ARROW))    &kp LC(SLASH)    &kp LANG_ZENKAKUHANKAKU    &trans          &trans  &trans  &trans
&none           &mkp MB4        &kp DELETE       &kp LC(LA(DOWN_ARROW))  &kp LS(LG(S))    &trans                     &kp KP_NUMLOCK  &trans  &trans  &trans
                                &trans                                   &trans           &trans                     &trans          &trans
            >;
        };
    };
};
